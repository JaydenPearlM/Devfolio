# Supabase Configuration
# Get these from your Supabase project dashboard: https://app.supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Configuration
# Comma-separated list of email addresses allowed to access admin panel
ADMIN_EMAILS=your-email@example.com,admin@example.com

# Server Configuration
# Port the backend server will listen on (default: 5000)
PORT=5000

# Database Configuration (Optional - defaults shown)
# The Supabase table name for projects
PROJECTS_TABLE=Devfolio

# The Supabase storage bucket name for project files
PROJECTS_BUCKET=uploads

# Frontend URL (for CORS if needed in the future)
# FRONTEND_URL=https://your-domain.com
