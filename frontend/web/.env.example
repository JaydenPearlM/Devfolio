# Supabase Configuration (Frontend)
# These are safe to expose - they're public keys
# Get from: https://app.supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Configuration (Frontend)
# Must match ADMIN_EMAILS in backend .env
VITE_ADMIN_EMAILS=your-email@example.com,admin@example.com
